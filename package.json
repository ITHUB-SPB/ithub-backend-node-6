{
    "name": "express",
    "version": "1.0.0",
    "type": "module",
    "description": "A production-ready Express.js REST API starter template with TypeScript, JWT authentication, role-based access control (RBAC), Prisma ORM, Redis caching, and comprehensive OpenAPI documentation powered by Scalar.",
    "homepage": "https://github.com/ITHUB-SPB/ithub-backend-node-6",
    "repository": {
        "type": "github",
        "directory": "express-starter",
        "url": "https://github.com/ITHUB-SPB/ithub-backend-node-6"
    },
    "main": "main.ts",
    "scripts": {
        "dev": "tsx src/main.ts --watch",
        "start": "node dist/main.js",
        "build": "tsc && tsc-alias",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:pull": "prisma db pull",
        "db:seed": "prisma db seed",
        "db:migrate": "prisma migrate dev",
        "db:migrate:deploy": "prisma migrate deploy",
        "db:migrate:reset": "prisma migrate reset",
        "db:format": "prisma format",
        "format": "biome format --write src",
        "format:files": "biome format --write",
        "lint": "biome lint --write src",
        "lint:files": "biome lint --write",
        "check": "biome check --write src",
        "check:files": "biome check --write",
        "ci:check": "biome check src",
        "docker:up": "docker-compose up -d",
        "docker:down": "docker-compose down",
        "docker:logs": "docker-compose logs -f"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.2.0",
        "@prisma/client": "^7.2.0",
        "@scalar/express-api-reference": "^0.8.30",
        "bcrypt": "^6.0.0",
        "chalk": "^5.6.2",
        "dotenv": "^18.0.9",
        "express": "^5.3.0",
        "express-zod-api": "^29.8.0",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.23.1",
        "redis": "^6.3.1",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.10",
        "@faker-js/faker": "^10.1.0",
        "@types/bcrypt": "^6.0.0",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.0.3",
        "@types/pg": "^8.16.0",
        "prisma": "^7.10.1",
        "tsc-alias": "^1.9.9",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3"
    }
}